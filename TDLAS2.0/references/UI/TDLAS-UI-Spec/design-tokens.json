{
  "formatNote": "Technology-neutral token data; dimensions use logical pixels.",
  "version": "1.0.0",
  "units": {"dimension": "logical-px", "color": "sRGB-hex", "duration": "ms"},
  "defaults": {"theme": "day", "locale": "zh-CN", "maximized": true, "activeTab": "customer", "simulationMustBeLabeled": true},
  "layout": {
    "referenceViewport": {"width": 1920, "height": 1080},
    "headerHeight": 56,
    "columns": {"leftFraction": 0.2, "rightFraction": 0.8, "outerGap": 0, "dividerWidthIncludedInLeft": 1},
    "panePadding": 16,
    "sectionGap": 12,
    "sectionPadding": 12,
    "sectionTitleHeight": 28,
    "parameterRowMinHeight": 40,
    "parameterRowGap": 4,
    "parameterLabelWidth": 128,
    "controlMinHeight": 40,
    "buttonGap": 8,
    "metricRowMinHeight": 56,
    "tabMinHeight": 44,
    "debugGrid": {"columns": 2, "rows": 2, "equalColumns": true, "equalRows": true, "gap": 16, "cardMinWidth": 360, "cardMinHeight": 240},
    "responsive": {"wideMinWidth": 1600, "contentMinWidth": 1440, "belowMinimum": "scroll-content", "compactLabels": "above-control", "preserveDebugGrid": true}
  },
  "spacing": {"none": 0, "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "xxl": 32},
  "radius": {"control": 6, "card": 8, "dialog": 12},
  "border": {"defaultWidth": 1, "focusWidth": 2, "focusOffset": 2},
  "typography": {
    "fontFamily": ["system-ui", "Microsoft YaHei", "PingFang SC", "Noto Sans CJK SC", "sans-serif"],
    "size": {"caption": 12, "body": 14, "section": 16, "title": 18, "metric": 24},
    "weight": {"regular": 400, "emphasis": 600},
    "lineHeight": {"body": 1.5, "heading": 1.3, "metric": 1.2},
    "numericVariant": "tabular-nums"
  },
  "motion": {"transitionMs": 120, "reducedMotionMs": 0},
  "chart": {
    "lineWidth": 2,
    "fitDash": [6, 4],
    "gridWidth": 1,
    "axisWidth": 1,
    "autoRangePaddingFraction": 0.1,
    "maxRenderFps": 20,
    "suggestedVisiblePointBudget": 5000,
    "downsampling": "preserve-extrema-for-render-only",
    "peakHistoryInterpolation": "linear",
    "connectNulls": false,
    "connectAcrossRuns": false,
    "peakReducer": "maximum-valid-finite-value-after-contract-processing",
    "peakTieBreak": "earliest-sample-position",
    "fvYAxisDirection": "increases-upward",
    "fvAbsorptionPeakDirection": "algorithm-defined",
    "peakSource": "one-complete-fv-curve-per-acquisition",
    "staleMinimumMs": 3000,
    "staleExpectedIntervalMultiplier": 3
  },
  "accessibility": {"normalTextContrastMinimum": 4.5, "largeTextContrastMinimum": 3, "essentialNonTextContrastMinimum": 3, "primaryTargetMinSize": 40, "statusMustIncludeText": true},
  "themes": {
    "day": {
      "background": "#F1F8FE",
      "surface": "#FFFFFF",
      "surfaceSubtle": "#E8F4FF",
      "text": "#083A88",
      "textSecondary": "#345A85",
      "borderSubtle": "#A8D2F5",
      "controlBorder": "#5F8FBD",
      "primary": "#0968E8",
      "primaryHover": "#0757C7",
      "onPrimary": "#FFFFFF",
      "focus": "#005FE0",
      "selectedTabBackground": "#D7EBFE",
      "selectedTabText": "#0646AD",
      "disabledBackground": "#E3EDF7",
      "disabledText": "#52677C",
      "success": "#087A39",
      "warning": "#8A4B00",
      "danger": "#C42335",
      "chartBackground": "#FFFFFF",
      "chartGrid": "#CFE4F6",
      "chartAxis": "#315A87",
      "seriesRaw": "#0968E8",
      "seriesFit": "#D86D00",
      "seriesFv": "#0968E8",
      "seriesPeak": "#0B63CE"
    },
    "night": {
      "background": "#091727",
      "surface": "#10243B",
      "surfaceSubtle": "#18334F",
      "text": "#EDF5FF",
      "textSecondary": "#B6C9DE",
      "borderSubtle": "#304A65",
      "controlBorder": "#7691AF",
      "primary": "#79BBFF",
      "primaryHover": "#A5D2FF",
      "onPrimary": "#0A2138",
      "focus": "#9BCCFF",
      "selectedTabBackground": "#234565",
      "selectedTabText": "#E4F2FF",
      "disabledBackground": "#21364C",
      "disabledText": "#A6B8CB",
      "success": "#7DDBA7",
      "warning": "#F8CB73",
      "danger": "#FFACA5",
      "chartBackground": "#10243B",
      "chartGrid": "#2A4159",
      "chartAxis": "#B0C4DA",
      "seriesRaw": "#7ABEFF",
      "seriesFit": "#FFB77A",
      "seriesFv": "#6CE0CD",
      "seriesPeak": "#D6A2FF"
    }
  }
}
